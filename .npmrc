# onnxruntime-node (pulled in by @huggingface/transformers) tries to download
# its large CUDA/GPU binaries from GitHub on every Linux x64 install — which is
# what Vercel's build machine is. That download fails there and breaks the
# build. The app runs its AI models in the browser and never needs the GPU
# build, so skip it. Windows and macOS never attempt the download, which is
# why `npm run build` works locally.
onnxruntime-node-install-cuda=skip
